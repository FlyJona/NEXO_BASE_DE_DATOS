# Copia este archivo como .env y cambia TODOS los valores "cambia_esto".
# Lo más fácil: ejecuta scripts/new_env.ps1, que crea .env con contraseñas aleatorias.
# Usa solo letras y números en las contraseñas: van dentro de una URL de conexión.
# .env nunca se sube a Git.

# Base de datos
POSTGRES_DB=nexo
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambia_esto_superusuario

# Roles de NEXO (se crean la primera vez que arranca el contenedor)
NEXO_MIGRATOR_PASSWORD=cambia_esto_migrator
NEXO_APP_PASSWORD=cambia_esto_app
PGRST_AUTHENTICATOR_PASSWORD=cambia_esto_authenticator

# Firma de los JWT de PostgREST: mínimo 32 caracteres
PGRST_JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres

# Puertos en el equipo (solo 127.0.0.1)
POSTGRES_HOST_PORT=5432
POSTGREST_HOST_PORT=3000
POSTGREST_ADMIN_HOST_PORT=3001
