        <mxCell id="leyenda" value="Modelo relacional — NEXO (PostgreSQL 16, esquema nexo). PK = llave primaria · FK = llave foránea · UQ = valor único · IDENTITY = autoincremental · NULL = opcional. Líneas: pata de gallo = muchos, barra doble = uno, círculo = cero o uno. Todas las FK son ON DELETE CASCADE salvo publicaciones.materia_id (SET NULL)." style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="1700" height="40" as="geometry" /></mxCell>
